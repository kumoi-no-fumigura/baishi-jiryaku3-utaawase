   ],
   "lb": []
  }
 ],
 "poems": [
  {
   "seq": "1",
   "text": "此比はつゝしの花に照されてはやまのしけりこくらからしな",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "君か世をなか月のけふ移しうふる菊にはならふ花なかりけり",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "君かためうつしうふれは菊の花ちとせ匂はんことそしるけれ",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "うつしみは冬しもふかくうつろへよ菊より又は花もあらしな",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "うつしうふる宿をやかねて菊の花嵐とゝもにをける白露",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "君かすむ宿に千年の秋をへてのとかに菊のにほふへきかな",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "露深くうへつる菊のえにしあれは濡れても千世の秋はへぬへし",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "うふるよりしかこそみゆれ白菊の久しかるへき花の匂ひは",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "なか月のなかきためしの菊の花心してをけ夜半の初霜",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "ふかきえを心にかけてうふるよりかすをきまされ菊の白露",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "色々のにほひをこめて初霜のおくゆかしけに見ゆるしら菊",
   "kana": "",
   "speaker": "",
   "page": 31,
   "pid": "1879502",
   "form": "短歌",
   "genre": ""
  }
 ],
